# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
tmp/*
!tmp/.gitkeep

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo/
.swc/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# CDK infrastructure
infra/node_modules
infra/dist
infra/cdk.out
infra/cdk.context.json

# prisma
*.db
*.db-journal

# Generated Prisma client (regenerated from schema via prisma generate)
/src/generated/

# logs
*.log

# editors
.idea/

# Claude Code agent worktrees (full checkouts made by coding agents)
.claude/worktrees/
