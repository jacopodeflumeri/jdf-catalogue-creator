{
  "name": "mapp-labs",
  "version": "1.0.40",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:debug": "node -e \"const r=require('child_process').spawnSync('next build',{stdio:'inherit',shell:true,env:{...process.env,ENABLE_SOURCE_MAPS:'true'}});process.exit(r.status===null?1:r.status)\"",
    "start": "next start",
    "worker": "node --import tsx src/workers/catalog-generation-worker.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "check-all": "npm run type-check && npm run lint && echo All checks passed!",
    "test": "jest --testPathIgnorePatterns=\"\\.db\\.test\\.\"",
    "test:watch": "jest --watch --testPathIgnorePatterns=\"\\.db\\.test\\.\"",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=\"\\.db\\.test\\.\"",
    "test:db": "jest --testPathPatterns=\"\\.db\\.test\\.\" --runInBand"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@notionhq/client": "^5.26.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "echarts": "^6",
    "echarts-for-react": "^3.0.2",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "next-auth": "^4.24.14",
    "openai": "^6.34.0",
    "pg": "^8.23.0",
    "prisma": "7.10.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.35.4",
    "ssh2-sftp-client": "^12.1.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@tailwindcss/postcss": "^4.2.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2-sftp-client": "^9.0.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
