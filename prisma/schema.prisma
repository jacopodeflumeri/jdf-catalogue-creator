// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Users table - base user authentication
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  mapp      Boolean?
  accountId Int?     @map("account")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  linkedAccount        Account?               @relation("UserLinkedAccount", fields: [accountId], references: [id], onDelete: SetNull)
  accountUsers         AccountUser[]
  activityLogs         AccountActivity[]
  accountData          AccountData[]          @relation("AccountDataUser")
  accountNotifications AccountNotifications[] @relation("NotificationUser")

  @@index([accountId])
  @@index([createdAt])
  @@map("user")
}

// Mapp team members (admins)
model MappTeam {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  email     String?  @unique
  firstname String?
  lastname  String?
  title     String?
  role      String?
  location  String?
  image     Json? // S3Image object with URL, metadata, and variants

  // Access Control Fields
  // No pending/approval step: the first Mapp user ever -> active/admin
  // (bootstrap), everyone after -> active/viewer. "suspended"/"denied" remain
  // for moderation. (See docs/template/PERMISSION-LEVELS.md.)
  accessStatus String    @default("active") @map("access_status") // "active", "suspended", "denied"
  accessLevel  String    @default("viewer") @map("access_level") // "viewer", "editor", "admin"
  lastLoginAt  DateTime? @map("last_login_at")
  authorizedBy Int?      @map("authorized_by")
  authorizedAt DateTime? @map("authorized_at")
  accessNotes  String?   @map("access_notes") // Admin notes about access decision

  // Relationships
  authorizedByMember        MappTeam?              @relation("MappTeamAuthorizer", fields: [authorizedBy], references: [id], onDelete: SetNull)
  authorizedMembers         MappTeam[]             @relation("MappTeamAuthorizer")
  activities                AccountActivity[]      @relation("ActivityMappUser")
  auditLogs                 AuditLog[]
  catalogGenerationJobs     CatalogGenerationJob[]
  archivedSyntheticProducts SyntheticProduct[]     @relation("SyntheticProductArchiver")

  @@index([email])
  @@index([accessStatus])
  @@index([accessLevel])
  @@map("mapp_team")
}

// Accounts (companies/customers)
model Account {
  id          Int      @id @default(autoincrement())
  name        String? // company name
  companyName String?  @map("company_name") // alias field
  sfAccountId String?  @map("sf_account_id") // Salesforce ID
  region      String?
  currency    String?
  vertical    String?
  status      String   @default("Prospect")
  stage       String   @default("Discovery")
  domains     Json? // array of domains
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  linkedUsers          User[]                 @relation("UserLinkedAccount")
  accountUsers         AccountUser[]
  accountData          AccountData[]
  accountActivity      AccountActivity[]
  accountNotifications AccountNotifications[]
  companyUsers         CompanyUser[]          @relation("CompanyUserAccount")

  @@index([sfAccountId])
  @@index([status])
  @@index([stage])
  @@index([createdAt])
  @@map("account")
}

// Account-User relationships (team members)
model AccountUser {
  id        Int      @id @default(autoincrement())
  accountId Int      @map("account_id")
  userId    Int      @map("user_id")
  access    String   @default("customer") // customer, admin, mapp
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
  @@index([status])
  @@map("account_user")
}

// Flexible JSON storage for account data (modules etc.)
model AccountData {
  id        Int      @id @default(autoincrement())
  accountId Int      @map("account_id")
  userId    Int?     @map("user_id")
  type      String // "modules", "billing", etc.
  data      Json // flexible JSON storage
  status    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?   @relation("AccountDataUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, type])
  @@map("account_data")
}

// Account activity/audit log
model AccountActivity {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  userId     Int      @map("user_id")
  accountId  Int      @map("account_id")
  type       String
  details    String?
  message    String?
  linkedId   Int?     @map("linked_id") // reference to related record
  mappUserId Int?     @map("mapp_user_id")

  // Relationships
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mappUser MappTeam? @relation("ActivityMappUser", fields: [mappUserId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([userId])
  @@index([createdAt])
  @@map("account_activity")
}

// Admin audit log: who changed what, and when. Written by server actions via
// `writeAuditLog` (src/modules/audit); read at /admin/audit-log. Distinct from
// AccountActivity above, which records what CUSTOMERS do inside one account.
//
// `entityType` is a key from AUDIT_ENTITY_TYPES (src/modules/audit/entity-types.ts)
// rather than a DB enum, so adding a type needs no migration.
//
// The actor is recorded twice on purpose: `mappUserId` is the joinable link and
// goes NULL if that team member is ever deleted (SetNull — deleting a person must
// never delete their history); `actorEmail` is a plain copy that survives it, and
// covers SuperAdmins who have no MappTeam row at all.
model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  mappUserId Int?     @map("mapp_user_id")
  actorEmail String?  @map("actor_email")
  action     String // verb, snake_case: "access_updated", "created", "deleted"
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  outcome    String?  @default("success") // "success" | "error"
  message    String? // one human-readable line
  data       Json? // structured detail, e.g. { before, after }

  mappUser MappTeam? @relation(fields: [mappUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([mappUserId])
  @@map("audit_log")
}

// Account notifications
model AccountNotifications {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  accountId Int      @map("account_id")
  userId    Int?     @map("user_id")
  data      Json // flexible JSON storage
  status    String?

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?   @relation("NotificationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@map("account_notifications")
}

// Company-Login (Keycloak / Mapp Cloud) customer identities.
//
// A durable record for each Mapp Cloud customer who signs in via "Company
// Login", keyed by the mapp-cloud user id + integer client-catalog company id.
// Stores identity + lastLogin used for spend/usage attribution that must
// survive beyond a live session. `companyId` is the client-catalog company id
// (string-encoded in the OIDC claim, stored here as Int).
//
// The link to a local `Account` is OPTIONAL and resolved at login via the
// pluggable `resolveAccountIdForCompany(companyId)` seam — the template ships a
// default that returns null (no company→account mapping). Apps that DO map a
// company to a local account (e.g. via an `Account.clientCatalogCompanyId` column)
// override that seam; the FK keeps usage attribution joinable when they do.
model CompanyUser {
  id          Int       @id @default(autoincrement())
  mappUserId  String    @map("mapp_user_id") // mapp-cloud user id (claim `userId`, e.g. "19140")
  companyId   Int       @map("company_id") // client-catalog company id
  tenantId    String?   @map("tenant_id")
  loginName   String?   @map("login_name") // "<companyprefix>.<username>" — display/debug only
  email       String?
  name        String?
  accountId   Int?      @map("account_id") // resolved via the app's company→account seam; null when unmapped
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relationships
  account Account? @relation("CompanyUserAccount", fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([mappUserId, companyId])
  @@index([companyId, lastLoginAt])
  @@index([accountId])
  @@map("company_user")
}

// Server-side half of a login session. The NextAuth session cookie is a JWT and
// every byte of it is sent on every request, so the claims whose size grows with
// the user's profile (roles, workspaces, LDAP groups) and the Keycloak id_token
// live here instead; the cookie carries only this row's id (`authSessionId`).
// Storing them in the cookie pushed users with many groups past Node's 16 KB
// request-header limit (HTTP 431 on every page).
//
// One row per login, not per user: the id_token identifies ONE Keycloak SSO
// session, so two browsers must not share it. Deleted on sign-out; `expiresAt`
// rolls forward while the session is in use and expired rows are pruned at the
// next login.
model AuthSession {
  id              String   @id @default(uuid())
  email           String?
  roles           Json? // string[]
  workspaces      Json? // { workspaceId, services[] }[]
  mappLdapGroups  Json?    @map("mapp_ldap_groups") // string[]
  keycloakIdToken String?  @map("keycloak_id_token") // federated-logout hint; never sent to the client
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("auth_session")
}

// Magic Links for authentication (OPTIONAL capability — see config.magicLink)
model MagicLink {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([expiresAt])
  @@index([used])
  @@map("magic_link")
}

// -----------------------------------------------------------------------------
// Synthetic catalog foundation
// -----------------------------------------------------------------------------

enum CatalogDepartment {
  WOMEN
  MEN
}

enum CatalogEntityStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum CatalogAvailability {
  IN_STOCK
  OUT_OF_STOCK
}

enum CatalogImageRole {
  FRONT
  BACK
  ON_MODEL
  COMPLETE_LOOK
}

enum CatalogImageStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

enum CatalogJobType {
  INITIAL
  ADD_PRODUCTS
  RETRY
  REGENERATE_IMAGE
  CATALOG_INFO
  CORE_IMAGES
  COMPLETE_LOOK
}

enum CatalogDepartmentMode {
  AUTO
  WOMEN
  MEN
}

enum CatalogJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum CatalogJobStage {
  PLANNING
  PRODUCTS
  IMAGES
  VALIDATING
  COMPLETE
}

enum SyntheticCompleteLookStatus {
  PLANNED
  QUEUED
  GENERATING
  READY
  FAILED
  SKIPPED
  STALE
}

enum CatalogTaskType {
  GENERATE_PRODUCT
  GENERATE_IMAGE
  VALIDATE_PRODUCT
}

enum CatalogTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LlmUsageOperation {
  CHAT_COMPLETION
  IMAGE_GENERATION
  IMAGE_EDIT
}

enum LlmCostBasis {
  TOKEN_USAGE
  CATALOG_ESTIMATE
  UNPRICED
}

model LlmUsage {
  id                Int               @id @default(autoincrement())
  requestId         String?           @map("request_id")
  feature           String
  model             String
  operation         LlmUsageOperation
  inputTokens       Int?              @map("input_tokens")
  cachedInputTokens Int?              @map("cached_input_tokens")
  outputTokens      Int?              @map("output_tokens")
  textInputTokens   Int?              @map("text_input_tokens")
  imageInputTokens  Int?              @map("image_input_tokens")
  textOutputTokens  Int?              @map("text_output_tokens")
  imageOutputTokens Int?              @map("image_output_tokens")
  estimatedCostUsd  Decimal?          @map("estimated_cost_usd") @db.Decimal(18, 8)
  costBasis         LlmCostBasis      @map("cost_basis")
  pricingSnapshot   Json?             @map("pricing_snapshot")
  usageSnapshot     Json?             @map("usage_snapshot")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([model, createdAt])
  @@index([feature, createdAt])
  @@index([operation, createdAt])
  @@map("llm_usage")
}

model SyntheticCatalog {
  id                  Int      @id @default(autoincrement())
  slug                String   @unique
  name                String
  segment             String
  brandName           String   @map("brand_name")
  externalPrefix      String   @unique @map("external_prefix")
  config              Json     @map("config_json")
  defaultTextModel    String   @map("default_text_model")
  defaultImageModel   String   @map("default_image_model")
  nextProductSequence Int      @default(1) @map("next_product_sequence")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  products SyntheticProduct[]
  jobs     CatalogGenerationJob[]

  @@index([active])
  @@map("synthetic_catalog")
}

model SyntheticProduct {
  id                   Int                 @id @default(autoincrement())
  catalogId            Int                 @map("catalog_id")
  generationJobId      Int?                @map("generation_job_id")
  sequence             Int
  externalId           String              @unique @map("external_id")
  name                 String
  description          String
  department           String
  category             String
  subcategory          String
  material             String
  season               String
  patternCode          String?             @map("pattern_code")
  embellishmentCodes   Json                @default("[]") @map("embellishment_codes")
  basePrice            Decimal             @map("base_price") @db.Decimal(12, 2)
  salePrice            Decimal?            @map("sale_price") @db.Decimal(12, 2)
  currency             String              @default("EUR")
  productUrl           String?             @map("product_url")
  status               CatalogEntityStatus @default(DRAFT)
  archivedAt           DateTime?           @map("archived_at")
  archivedByMappTeamId Int?                @map("archived_by_mapp_team_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  catalog       SyntheticCatalog        @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  generationJob CatalogGenerationJob?   @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  styles        SyntheticStyle[]
  tasks         CatalogGenerationTask[]
  archivedBy    MappTeam?               @relation("SyntheticProductArchiver", fields: [archivedByMappTeamId], references: [id], onDelete: SetNull)

  @@unique([catalogId, sequence])
  @@index([catalogId, department])
  @@index([generationJobId])
  @@index([status])
  @@index([catalogId, archivedAt])
  @@index([archivedByMappTeamId])
  @@map("synthetic_product")
}

model SyntheticStyle {
  id         Int                 @id @default(autoincrement())
  productId  Int                 @map("product_id")
  externalId String              @unique @map("external_id")
  colorName  String              @map("color_name")
  colorCode  String              @map("color_code")
  colorHex   String?             @map("color_hex")
  visualSpec Json?               @map("visual_spec")
  status     CatalogEntityStatus @default(DRAFT)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  product      SyntheticProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants     SyntheticVariant[]
  images       SyntheticImageAsset[]
  tasks        CatalogGenerationTask[]
  completeLook SyntheticCompleteLook?      @relation("CompleteLookAnchor")
  companionIn  SyntheticCompleteLookItem[] @relation("CompleteLookCompanion")

  @@unique([productId, colorCode])
  @@index([productId])
  @@index([status])
  @@map("synthetic_style")
}

model SyntheticVariant {
  id           Int                 @id @default(autoincrement())
  styleId      Int                 @map("style_id")
  externalId   String              @unique @map("external_id")
  sku          String              @unique
  size         String
  stock        Int                 @default(0)
  availability CatalogAvailability @default(OUT_OF_STOCK)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  style SyntheticStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, size])
  @@index([styleId])
  @@index([availability])
  @@map("synthetic_variant")
}

model SyntheticImageAsset {
  id               Int                @id @default(autoincrement())
  publicId         String             @unique @default(uuid()) @map("public_id")
  styleId          Int                @map("style_id")
  role             CatalogImageRole
  status           CatalogImageStatus @default(QUEUED)
  storageKey       String?            @map("storage_key")
  mimeType         String?            @map("mime_type")
  width            Int?
  height           Int?
  model            String?
  prompt           String?
  referenceAssetId Int?               @map("reference_asset_id")
  errorMessage     String?            @map("error_message")
  attemptCount     Int                @default(0) @map("attempt_count")
  generatedAt      DateTime?          @map("generated_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  style          SyntheticStyle          @relation(fields: [styleId], references: [id], onDelete: Cascade)
  referenceAsset SyntheticImageAsset?    @relation("ImageAssetReference", fields: [referenceAssetId], references: [id], onDelete: SetNull)
  derivedAssets  SyntheticImageAsset[]   @relation("ImageAssetReference")
  tasks          CatalogGenerationTask[]
  completeLook   SyntheticCompleteLook?  @relation("CompleteLookAsset")

  @@unique([styleId, role])
  @@index([status])
  @@index([referenceAssetId])
  @@map("synthetic_image_asset")
}

model SyntheticCompleteLook {
  id              Int                         @id @default(autoincrement())
  anchorStyleId   Int                         @unique @map("anchor_style_id")
  imageAssetId    Int?                        @unique @map("image_asset_id")
  status          SyntheticCompleteLookStatus @default(PLANNED)
  selectionReason String?                     @map("selection_reason")
  scoringSnapshot Json?                       @map("scoring_snapshot")
  errorMessage    String?                     @map("error_message")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  anchorStyle SyntheticStyle              @relation("CompleteLookAnchor", fields: [anchorStyleId], references: [id], onDelete: Cascade)
  imageAsset  SyntheticImageAsset?        @relation("CompleteLookAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)
  items       SyntheticCompleteLookItem[]

  @@index([status])
  @@map("synthetic_complete_look")
}

model SyntheticCompleteLookItem {
  id               Int      @id @default(autoincrement())
  completeLookId   Int      @map("complete_look_id")
  companionStyleId Int      @map("companion_style_id")
  outfitSlot       String   @map("outfit_slot")
  sortOrder        Int      @map("sort_order")
  scoreSnapshot    Json?    @map("score_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  completeLook   SyntheticCompleteLook @relation(fields: [completeLookId], references: [id], onDelete: Cascade)
  companionStyle SyntheticStyle        @relation("CompleteLookCompanion", fields: [companionStyleId], references: [id], onDelete: Cascade)

  @@unique([completeLookId, companionStyleId])
  @@unique([completeLookId, sortOrder])
  @@index([companionStyleId])
  @@map("synthetic_complete_look_item")
}

model CatalogGenerationJob {
  id                  Int                   @id @default(autoincrement())
  publicId            String                @unique @default(uuid()) @map("public_id")
  catalogId           Int                   @map("catalog_id")
  sourceJobId         Int?                  @map("source_job_id")
  createdByMappTeamId Int?                  @map("created_by_mapp_team_id")
  jobType             CatalogJobType        @map("job_type")
  requestedProducts   Int                   @map("requested_products")
  departmentMode      CatalogDepartmentMode @default(AUTO) @map("department_mode")
  scopeType           String                @default("LEGACY") @map("scope_type")
  scopeValue          String?               @map("scope_value")
  colorVariantCount   Int                   @default(1) @map("color_variant_count")
  textModel           String                @map("text_model")
  imageModel          String                @map("image_model")
  status              CatalogJobStatus      @default(QUEUED)
  stage               CatalogJobStage       @default(PLANNING)
  completedProducts   Int                   @default(0) @map("completed_products")
  failedProducts      Int                   @default(0) @map("failed_products")
  completedImages     Int                   @default(0) @map("completed_images")
  failedImages        Int                   @default(0) @map("failed_images")
  skippedImages       Int                   @default(0) @map("skipped_images")
  errorMessage        String?               @map("error_message")
  startedAt           DateTime?             @map("started_at")
  finishedAt          DateTime?             @map("finished_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  catalog     SyntheticCatalog        @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  sourceJob   CatalogGenerationJob?   @relation("CatalogJobSource", fields: [sourceJobId], references: [id], onDelete: SetNull)
  derivedJobs CatalogGenerationJob[]  @relation("CatalogJobSource")
  createdBy   MappTeam?               @relation(fields: [createdByMappTeamId], references: [id], onDelete: SetNull)
  products    SyntheticProduct[]
  tasks       CatalogGenerationTask[]

  @@index([catalogId, createdAt])
  @@index([status, createdAt])
  @@index([createdByMappTeamId])
  @@index([sourceJobId])
  @@map("catalog_generation_job")
}

model CatalogGenerationTask {
  id           Int               @id @default(autoincrement())
  jobId        Int               @map("job_id")
  productId    Int?              @map("product_id")
  styleId      Int?              @map("style_id")
  imageAssetId Int?              @map("image_asset_id")
  taskType     CatalogTaskType   @map("task_type")
  status       CatalogTaskStatus @default(QUEUED)
  dedupeKey    String            @map("dedupe_key")
  payload      Json?
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3) @map("max_attempts")
  availableAt  DateTime          @default(now()) @map("available_at")
  lockedAt     DateTime?         @map("locked_at")
  lockedBy     String?           @map("locked_by")
  lastError    String?           @map("last_error")
  startedAt    DateTime?         @map("started_at")
  finishedAt   DateTime?         @map("finished_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  job        CatalogGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product    SyntheticProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  style      SyntheticStyle?      @relation(fields: [styleId], references: [id], onDelete: SetNull)
  imageAsset SyntheticImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@unique([jobId, dedupeKey])
  @@index([status, availableAt])
  @@index([jobId, status])
  @@index([productId])
  @@index([styleId])
  @@index([imageAssetId])
  @@map("catalog_generation_task")
}
