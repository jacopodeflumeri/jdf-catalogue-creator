#!/bin/sh
#
# Pre-push hook: Prevent accidental pushes to the template repository.
#
# This hook blocks pushes to mapp-digital/labs-app-template.
# If you're working on the template itself, bypass with: git push --no-verify
#

# Git passes the remote name as $1 and the URL being pushed to as $2. Check $2
# (the actual destination) rather than origin's URL, so a push is judged on
# where it really goes, whichever remote or URL was named.
REMOTE_URL="${2:-}"

if echo "$REMOTE_URL" | grep -q "mapp-digital/labs-app-template"; then
    echo ""
    echo "ERROR: You are trying to push to the template repository!"
    echo ""
    echo "  Remote: $REMOTE_URL"
    echo ""
    echo "This is the Mapp Labs App Template. You should push to your own repo instead."
    echo ""
    echo "To fix this:"
    echo "  1. Create your repo at: https://github.com/organizations/mapp-labs/repositories/new"
    echo "  2. Run: git remote set-url origin git@github.com:mapp-labs/<your-repo-name>.git"
    echo "  3. Or run: ./scripts/setup.sh  (handles this automatically)"
    echo ""
    echo "If you actually intend to push to the template repo, use:"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi
