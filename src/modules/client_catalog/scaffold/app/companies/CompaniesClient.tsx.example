/**
 * Companies list UI + Discover trigger.
 * Destination: src/app/admin/companies/CompaniesClient.tsx
 */
"use client";

import { useState, useTransition } from "react";
import Link from "next/link";
import Button from "@/components/ui/Button";
import { companyPath } from "@/lib/admin/company-links";
import { runDiscovery } from "@/lib/actions/admin/company-admin-actions";

type CompanyRow = {
  id: number;
  name: string | null;
  clientCatalogCompanyId: number;
  _count: { workspaces: number };
};

export default function CompaniesClient({
  companies,
}: {
  companies: CompanyRow[];
}) {
  const [isPending, startTransition] = useTransition();
  const [message, setMessage] = useState<string | null>(null);

  const onDiscover = () => {
    setMessage(null);
    startTransition(async () => {
      const res = await runDiscovery();
      setMessage(res.message);
    });
  };

  return (
    <div>
      <div className="mb-6 flex items-center justify-between">
        <h1 className="text-2xl font-semibold">Companies</h1>
        <Button onClick={onDiscover} disabled={isPending}>
          {isPending ? "Discovering…" : "Discover"}
        </Button>
      </div>

      {message && <p className="mb-4 text-sm text-gray-600">{message}</p>}

      {companies.length === 0 ? (
        <p className="text-sm text-gray-500">
          No companies yet. Click “Discover” to import them from the Client
          Catalog.
        </p>
      ) : (
        <table className="w-full text-sm">
          <thead>
            <tr className="border-b text-left">
              <th className="py-2">Company</th>
              <th className="py-2">Company ID</th>
              <th className="py-2">Workspaces</th>
            </tr>
          </thead>
          <tbody>
            {companies.map((c) => (
              <tr key={c.id} className="border-b">
                <td className="py-2">
                  <Link
                    href={companyPath(c.clientCatalogCompanyId)}
                    className="text-primary-600 hover:underline"
                  >
                    {c.name ?? `Company ${c.clientCatalogCompanyId}`}
                  </Link>
                </td>
                <td className="py-2">{c.clientCatalogCompanyId}</td>
                <td className="py-2">{c._count.workspaces}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  );
}
