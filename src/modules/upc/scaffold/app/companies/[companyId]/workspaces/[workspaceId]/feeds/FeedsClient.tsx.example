/**
 * Feeds list UI + "Sync feeds" trigger.
 * Destination: src/app/admin/companies/[companyId]/workspaces/[workspaceId]/feeds/FeedsClient.tsx
 */
"use client";

import { useState, useTransition } from "react";
import Link from "next/link";
import Button from "@/components/ui/Button";
import { feedPath } from "@/lib/admin/catalog-links";
import { syncWorkspaceFeeds } from "@/lib/actions/admin/upc-catalog-actions";

type FeedRow = {
  id: number;
  upcFeedId: number;
  name: string | null;
  feedDataType: string | null;
  products: number;
  updatedAt: string;
};

export default function FeedsClient({
  companyId,
  workspaceId,
  workspaceName,
  workspaceInternalId,
  feeds,
}: {
  companyId: number;
  workspaceId: number;
  workspaceName: string | null;
  workspaceInternalId: number;
  feeds: FeedRow[];
}) {
  const [isPending, startTransition] = useTransition();
  const [message, setMessage] = useState<string | null>(null);

  const onSync = () => {
    setMessage(null);
    startTransition(async () => {
      const res = await syncWorkspaceFeeds(workspaceInternalId);
      setMessage(res.message);
    });
  };

  return (
    <div>
      <div className="mb-6 flex items-center justify-between">
        <h1 className="text-2xl font-semibold">
          {workspaceName ?? `Workspace ${workspaceId}`} — Feeds
        </h1>
        <Button onClick={onSync} disabled={isPending}>
          {isPending ? "Syncing…" : "Sync feeds"}
        </Button>
      </div>

      {message && <p className="mb-4 text-sm text-gray-600">{message}</p>}

      {feeds.length === 0 ? (
        <p className="text-sm text-gray-500">
          No feeds yet. Click “Sync feeds” to import them from the Product Feed
          Service.
        </p>
      ) : (
        <table className="w-full text-sm">
          <thead>
            <tr className="border-b text-left">
              <th className="py-2">Feed</th>
              <th className="py-2">Products</th>
              <th className="py-2">Data type</th>
              <th className="py-2">Updated</th>
            </tr>
          </thead>
          <tbody>
            {feeds.map((f) => (
              <tr key={f.id} className="border-b">
                <td className="py-2">
                  <Link
                    href={feedPath(companyId, workspaceId, f.upcFeedId)}
                    className="text-primary-600 hover:underline"
                  >
                    {f.name ?? `Feed ${f.upcFeedId}`}
                  </Link>
                </td>
                <td className="py-2">{f.products}</td>
                <td className="py-2">{f.feedDataType ?? "—"}</td>
                <td className="py-2">{new Date(f.updatedAt).toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  );
}
