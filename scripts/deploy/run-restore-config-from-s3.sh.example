#!/bin/bash
set -e

# Run scripts/data-sync/restore-config-from-s3.ts inside an ECS task.
# Usage: ./run-restore-config-from-s3.sh [staging|production] [extra args...]
#
# Examples:
#   ./run-restore-config-from-s3.sh staging
#   ./run-restore-config-from-s3.sh staging --dry-run
#   ./run-restore-config-from-s3.sh staging --key=config/prod/myapp/2026-05-14T15-30-00.json.gz
#   ./run-restore-config-from-s3.sh staging --source=staging
#
# Requires:
#   - The Data Sync capability enabled (DataSyncIntegration in the CDK stack)
#   - scripts/data-sync/restore-config-from-s3.ts present (copy from .example)
#
# To activate: drop the `.example` suffix and `chmod +x` this file.

ENV="${1:-staging}"
shift || true
EXTRA_ARGS="$*"

AWS_PROFILE="${AWS_PROFILE:-labs-power}"
AWS_REGION="eu-central-1"
source "$(dirname "$0")/_config.sh"

CLUSTER_NAME="${APP_NAME}-${SHORT_ENV}"
SERVICE_NAME="${APP_NAME}-${SHORT_ENV}"

echo "=========================================="
echo "  Restore config from mapp-labs-data-sync"
echo "=========================================="
echo "  Environment: ${ENV}"
echo "  Cluster:     ${CLUSTER_NAME}"
echo "  Extra args:  ${EXTRA_ARGS:-(none)}"
echo "=========================================="
echo ""

TASK_ARN=$(aws ecs list-tasks \
    --cluster "${CLUSTER_NAME}" \
    --service-name "${SERVICE_NAME}" \
    --desired-status RUNNING \
    --region "${AWS_REGION}" \
    --profile "${AWS_PROFILE}" \
    --query 'taskArns[0]' \
    --output text)

if [ "$TASK_ARN" = "None" ] || [ -z "$TASK_ARN" ]; then
    echo "Error: No running tasks found in ${CLUSTER_NAME}/${SERVICE_NAME}"
    exit 1
fi

echo "Task ARN: ${TASK_ARN}"
echo ""

aws ecs execute-command \
    --cluster "${CLUSTER_NAME}" \
    --task "${TASK_ARN}" \
    --container App \
    --interactive \
    --command "sh -c 'export DATABASE_URL=\"postgresql://\${DB_USER}:\${DB_PASSWORD}@\${DB_HOST}:\${DB_PORT}/\${DB_NAME}?sslmode=require\" && npx tsx scripts/data-sync/restore-config-from-s3.ts ${EXTRA_ARGS}'" \
    --region "${AWS_REGION}" \
    --profile "${AWS_PROFILE}"
