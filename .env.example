# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=Mapp Labs
# Optional UI-only override; does not change the AWS resource/billing app slug.
# APP_DISPLAY_NAME=Sales Coach
APP_URL=http://localhost:3000

# Environment Badge (displays banner in upper-right for non-production)
# Values: development, staging, production (or leave unset for no banner)
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# Authentication
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=SETUP_WILL_GENERATE

# Super Admin Configuration - comma-separated list of emails
SUPER_ADMINS=SETUP_WILL_PROMPT

# Extra origins accepted by the CSRF Origin/Referer check, comma-separated.
# The request's own host and APP_URL are always allowed; only set this if
# another origin legitimately posts to the app.
#ALLOWED_ORIGINS=https://other.example.com

# Security Restrictions Configuration
# NOTE: There is no pending/approval workflow. The FIRST Mapp user to log in
# becomes active/admin (bootstrap); everyone after is active/viewer. An admin
# promotes others as needed. "suspended"/"denied" remain for moderation.
ADMIN_ALLOWED_IPS=
ADMIN_ENABLE_IP_CHECK=false
ADMIN_SUPERADMIN_ONLY=false

# Magic Link (OPTIONAL capability, OFF by default)
# The template serves apps that may have non-company users; magic-link is the
# legacy email-link customer path, kept cleanly separated from Keycloak. Most
# apps leave this off and use Company Login. Set MAGIC_LINK_ENABLED=true to turn
# on the /auth/signin form, the send-magic-link route, and the credentials
# provider.
MAGIC_LINK_ENABLED=false
MAGIC_LINK_EXPIRY=3600

# Dev auth bypass (LOCAL ONLY) — sign in without AWS/Keycloak. Double-gated:
# honored only when DEV_AUTH_ENABLED=true AND NODE_ENV!=production. Enables the
# /auth/dev page + a mock IdP that runs the REAL hydration/eligibility code.
DEV_AUTH_ENABLED=false

# Admin auth-debug page (/admin/auth-debug) — read-only session/claims inspector.
# On by default in development; in production it needs AUTH_DEBUG_ENABLED=true.
#AUTH_DEBUG_ENABLED=false

# =============================================================================
# Legacy: Microsoft Entra (Azure AD) direct login
# Not needed for new apps — Keycloak (below) is the recommended path and has
# its own Entra IdP behind the "Mapp Entra ID" button. These variables are
# only relevant if you are maintaining an older app that has not yet migrated
# off direct Azure login. If you do need them, register a dev Entra app via
# ITHELPDESK and set the values here. See: docs/template/ENTRA-SETUP.md
# =============================================================================
#AZURE_AD_CLIENT_ID=
#AZURE_AD_CLIENT_SECRET=
#AZURE_AD_TENANT_ID=

# =============================================================================
# Keycloak (shared across all Labs apps via /labs/labs-portal/* SSM)
# When enabled, /auth/admin shows the new buttons (Mapp Entra ID + Company Login).
# The KC client + secret are SHARED for every Labs app — they auto-copy from the
# /labs/labs-portal/* SSM namespace when you run `make staging-ssm-setup`, so
# you do NOT need to ask anyone for these values.
# For LOCAL dev: only ports 3000–3002 are pre-registered on labs-portal. Run
# the dev server on one of those. See docs/template/KEYCLOAK.md for details.
# =============================================================================
KEYCLOAK_ENABLED=true
# Below are populated for you by `make staging-ssm-setup`. For local dev, fetch the
# secret once from shared SSM:
#   aws ssm get-parameter --name /labs/labs-portal/client-secret --with-decryption \
#     --query Parameter.Value --output text --profile labs-power --region eu-central-1
# (The realm is embedded in the issuer path — no separate KEYCLOAK_REALM needed.)
#KEYCLOAK_ISSUER=https://idp-int.shortest-route.com/realms/labs
#KEYCLOAK_CLIENT_ID=labs-portal
#KEYCLOAK_CLIENT_SECRET=<from /labs/labs-portal/client-secret>
#KEYCLOAK_IDP_HINT=mapp-entra-id
#KEYCLOAK_COMPANY_IDP_HINT=mapp-cloud-company

# Temporary workaround until INT KC TLS is fixed — disables TLS verification on
# KC backchannel calls (token / userinfo / jwks). Required for staging right
# now. Remove when /labs/labs-portal/tls-insecure flips back to "false".
KEYCLOAK_TLS_INSECURE=true

# Extra CA chain (PEM) for a Keycloak host whose cert is NOT under the vendored
# Mapp internal root CA — rarely needed (see docs/template/INTERNAL-CA.md). In
# AWS it is injected from SSM /{appName}-{env}/KEYCLOAK_CA_PEM; locally, leave unset.
#KEYCLOAK_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Company Login capability (default ON). Set to false for a Mapp-INTERNAL-ONLY
# app: external Mapp Cloud customers can no longer sign in with company context
# (the customer login path is refused, the admin Company Users views are hidden).
# Also reflected in app.config.json `enabledCapabilities`.
#COMPANY_LOGIN_ENABLED=true

# =============================================================================
# Optional: Customer Preview ("View as customer", default OFF)
# See: docs/template/capabilities/CUSTOMER_PREVIEW.md
# =============================================================================
# Admin-level users preview a company's /account pages exactly as its
# Company-Login customers see them (read-only, 30 min, audited). Needs Company
# Login. No secret: the token is signed with NEXTAUTH_SECRET.
#CUSTOMER_PREVIEW_ENABLED=true
# Workspace service codes granted during a preview — the codes your
# customerEligibilityPolicy checks (Keycloak claim codes, not client-catalog
# product names). Leave empty only with the template's allow-all policy.
#CUSTOMER_PREVIEW_SERVICES=

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=localdev
DB_NAME=myapp
DB_SSL=false
DB_MAX_CONNECTIONS=15
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Full DATABASE_URL (optional — auto-constructed from DB_* variables above if not set)
# Uncomment to override with a custom connection string:
#DATABASE_URL="postgresql://postgres:localdev@localhost:5432/myapp"

# Test database for *.db.test.ts. `make dev-test` / `make dev-test-db` set this
# for you (TEST_DB_* vars in the Makefile); only set it to run jest directly.
#DATABASE_URL_TEST="postgresql://postgres:localdev@localhost:5432/myapp_test"

# =============================================================================
# AWS S3 Configuration (capability: s3_storage)
# =============================================================================
# Per-app, per-env bucket: mapp-labs-{appName}-{staging|prod}. In ECS the bucket
# name is injected by CDK and credentials come from the task role — you only set
# these for local development.
#
# Who can read what is NOT configured here: it is declared per key prefix in
# src/modules/s3_images/config/prefixes.ts. See docs/template/capabilities/S3_STORAGE.md.
#
# Verify once per environment that the bucket blocks public access (all four
# settings must be true) — objects carry direct S3 URLs that bypass the app:
#   aws s3api get-public-access-block --bucket mapp-labs-{appName}-{env} --profile labs-power
#S3_ACCESS_KEY_ID=your-aws-access-key-id
#S3_SECRET_ACCESS_KEY=your-aws-secret-access-key

S3_REGION=eu-central-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_MAX_FILE_SIZE=100

# Optional CDN. NOTE: a CloudFront URL bypasses the app's access control
# entirely, so only enable this if the bucket/distribution serves content you
# are content to have fetched without a session.
#CLOUDFRONT_DOMAIN=your-cloudfront-domain

# =============================================================================
# Optional: SFTP (capability: sftp)
# =============================================================================
# File exchange with ONE external SFTP endpoint. All access is confined to
# {SFTP_ROOT_PATH}/{app.config.json appName} — see docs/template/capabilities/SFTP.md.
#SFTP_HOST=sftp.example.com
#SFTP_PORT=22
#SFTP_USERNAME=your-service-account
#SFTP_PASSWORD=your-service-account-password
#SFTP_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
#SFTP_PASSPHRASE=your-private-key-passphrase
#
# Base directory on the remote host. The app's own subdirectory is appended to
# this, so two apps sharing a host cannot overwrite each other.
#SFTP_ROOT_PATH=/
#
# REQUIRED. Pinned SHA-256 host key fingerprint. Without it the client accepts
# any host key, which lets an attacker on the network path impersonate the
# server and capture the credential above. Get it with:
#   ssh-keyscan -t ed25519 sftp.example.com | ssh-keygen -lf -
#SFTP_HOST_FINGERPRINT=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Local development against a throwaway server only. Refused in production.
#SFTP_ALLOW_UNKNOWN_HOST_KEY=false
#
# Max bytes per transfer (default 25MB). Files are buffered in memory.
#SFTP_MAX_FILE_BYTES=26214400
#
# Only for counterparties that dictate their own directory layout. Removes the
# per-app subdirectory, so you then depend entirely on a server-side chroot.
#SFTP_DISABLE_APP_PREFIX=false

# =============================================================================
# Optional: Mapp Engage API Configuration
# =============================================================================
#ENGAGE_BASE_URL=https://amundsen.shortest-route.com/ecircle_marketing/api/rest/v10
# ENGAGE_AUTH_TOKEN is "Basic " + base64 of user:pass — generate with: printf 'user:pass' | base64
#ENGAGE_AUTH_TOKEN=Basic your-base64-encoded-credentials
#NEXT_PUBLIC_ENGAGE_GROUP_ID=your-engage-group-id
#NEXT_PUBLIC_ENGAGE_MESSAGE_ID=your-engage-message-id

# =============================================================================
# Shared internal-API OAuth2 credential (Keycloak realm `s2s`)
# See: docs/template/INTERNAL-API.md
# =============================================================================
# ONE client-credentials credential authenticates the app to ALL internal Mapp
# services (Company Management Service / client catalog, Product Feed Service /
# UPC, ...). Individual integrations do NOT carry their own token-url/client-id/
# secret — they share these three vars and keep only their own base URL.
# The realm-s2s client must be authorized for the services the app calls; the
# default `mapp-labs` client reaches both client catalog and product feed.
#
# DO NOT INVENT THESE VALUES AND DO NOT ASK THE APP OWNER FOR THEM. They are
# already provisioned in shared SSM (account 936190502406 / eu-central-1). Fetch:
#
# The shared namespace is PER-ENVIRONMENT: /mapp-labs-stg for staging (and for
# local dev, which should point at INT), /mapp-labs for production. The `s2s`
# client id is `mapp-labs` in both realms but THE SECRET DIFFERS — a production
# secret returns `unauthorized_client` against INT. For local dev use the STAGING
# (INT) values; never point local or staging at the production prefix.
#
#   aws ssm get-parameters-by-path --path /mapp-labs-stg --recursive --with-decryption \
#     --profile labs-power --region eu-central-1 \
#     --query 'Parameters[].[Name,Value]' --output text
#
#   /mapp-labs-stg/internal-api/token-url      -> INTERNAL_API_TOKEN_URL
#   /mapp-labs-stg/internal-api/client-id      -> INTERNAL_API_CLIENT_ID  (mapp-labs)
#   /mapp-labs-stg/internal-api/client-secret  -> INTERNAL_API_CLIENT_SECRET (SecureString)
#   /mapp-labs-stg/catalog/cms-base-url        -> CLIENT_CATALOG_BASE_URL
#
# For AWS deploys nothing is app-scoped: infra/lib/stack.ts reads the shared
# per-environment prefix directly. See docs/template/INTERNAL-API.md.
#INTERNAL_API_TOKEN_URL=https://idp-int.shortest-route.com/realms/s2s/protocol/openid-connect/token
#INTERNAL_API_CLIENT_ID=mapp-labs
#INTERNAL_API_CLIENT_SECRET=  # from /mapp-labs-stg/internal-api/client-secret — never commit
# NOTE: internal service base URLs below are https against internal hosts; their
# ingress certs are issued by the Mapp internal root CA, which is vendored in the
# image and trusted via the Dockerfile/entrypoint — no extra CA env. See
# docs/template/INTERNAL-CA.md.

# =============================================================================
# Optional: Client Catalog (Company Management Service)
# See: docs/template/capabilities/CLIENT_CATALOG.md
# =============================================================================
# Auth uses the shared INTERNAL_API_* credential above. Only the base URL is
# per-service. (CLIENT_CATALOG_BASIC_* is a QA-only fallback when INTERNAL_API_*
# is not configured.)
#
# The GUM base URL IS per-environment — there is an INT deployment and a PROD
# deployment. Local dev and staging use INT; only production uses the prod host.
# Mirrored at <prefix>/catalog/cms-base-url (source of truth if a host moves):
#   staging/local -> /mapp-labs-stg/catalog/cms-base-url  (k8s-int-01)
#   production    -> /mapp-labs/catalog/cms-base-url      (k8s-prod-01)
# The value below is INT, matching the INT credential above — the two must always
# be from the same environment or the token is rejected.
#CLIENT_CATALOG_BASE_URL=https://company-management-service.k8s-int-01.nbg.webtrekk.com/gum-service/api
#CLIENT_CATALOG_BASIC_USERNAME=
#CLIENT_CATALOG_BASIC_PASSWORD=

# =============================================================================
# Optional: UPC (Unified Product Catalog / Product Feed Service)
# See: docs/template/capabilities/UPC.md
# =============================================================================
# Auth uses the shared INTERNAL_API_* credential above. Only the base URL is
# per-service.
#UPC_API_BASE_URL=https://your-upc-url

# =============================================================================
# Optional: FTL (Fashion Trends Lab)
# See: docs/template/capabilities/FTL.md
# =============================================================================
#FTL_API_BASE_URL=https://stg-ftl.labs.mapp.com
#FTL_API_KEY=your-ftl-api-key

# =============================================================================
# Optional: LLM (LiteLLM Proxy)
# See: docs/template/capabilities/LLM.md
# =============================================================================
LITELLM_API_KEY=sk-CAni4RKI01O0u5ZlERcGZQ
LITELLM_BASE_URL=https://llm-proxy.labs.mapp.com

# Mapp product this app belongs to: fashion, engage, intelligence, or internal.
# Cost-allocation dimension: mirrors the AWS `Product` tag and is used for LiteLLM
# spend attribution. Set for every app (not just LLM apps); setup.sh fills it in.
#APP_PRODUCT=internal

# =============================================================================
# Optional: User Feedback
# See: docs/template/capabilities/USER_FEEDBACK.md
# =============================================================================
# In-app feedback widget -> shared Notion "App Feedback" database. Both values
# are the SAME for every Labs app, so store them once as SHARED SSM SecureStrings
# (/labs-shared/feedback/*) rather than per-app. No in-app LLM; a centralized
# Notion agent handles triage.
#NOTION_API_KEY=secret_your-notion-integration-token
#NOTION_FEEDBACK_DATABASE_ID=your-shared-app-feedback-database-id
